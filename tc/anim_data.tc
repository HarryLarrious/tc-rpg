/** Index of channel name in a pose (generated). */
function chan(name: str): num {
    line c = {root_p: 1, root_r: 2, bob: 3, fwd: 4, t_p: 5, t_y: 6, t_r: 7, h_p: 8, h_y: 9, ua_r_p: 10, ua_r_y: 11, ua_r_o: 12, el_r: 13, ua_l_p: 14, ua_l_y: 15, ua_l_o: 16, el_l: 17, th_r_p: 18, th_r_o: 19, kn_r: 20, th_l_p: 21, th_l_o: 22, kn_l: 23, m_p: 24, m_y: 25, m_r: 26, o_p: 27, o_y: 28, o_r: 29};
    return line c[name] as num;
}

