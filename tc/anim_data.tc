/** Index of channel name in a pose (generated). */
function chan(name: str): num {
    line c = {root_p: 1, root_y: 2, root_r: 3, bob: 4, fwd: 5, sq: 6, t_p: 7, t_y: 8, t_r: 9, h_p: 10, h_y: 11, h_r: 12, a_r_p: 13, a_r_y: 14, a_r_o: 15, a_l_p: 16, a_l_y: 17, a_l_o: 18, l_r_p: 19, l_r_o: 20, l_l_p: 21, l_l_o: 22, m_p: 23, m_y: 24, m_r: 25, o_p: 26, o_y: 27, o_r: 28};
    return line c[name] as num;
}

