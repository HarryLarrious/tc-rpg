// Generated by pack/src/character.py: do not edit.
// Rig pivots per build in model pixels (1/16 block at scale 1), feet at y 0.

/** Per build: [hipY, hipX, neckY, shoulderX, shoulderY, armLen, legLen, torsoDepth]. */
declare global rigBuild: dict[list];

function loadRigData {
    global rigBuild = {};
    global rigBuild["m"] = [12, 2, 24, 6, 22, 12, 12, 4];
    global rigBuild["f"] = [12, 1.75, 24, 5, 22, 12, 12, 4];
    global rigBuild["dm"] = [8, 2.5, 18, 7, 16, 10, 8, 6];
    global rigBuild["df"] = [8, 2.25, 18, 6.25, 16, 10, 8, 5];
}

/** Option lists for the character designer. */
function rigOptions(kind: str): list[str] {
    if (kind == "armor") { return ["leather", "chain", "scale", "plate", "robe", "ranger", "noble", "bone"]; }
    if (kind == "hair") { return ["short", "long", "ponytail", "braid", "bun", "mohawk", "curly", "spiky", "bob", "shaggy"]; }
    if (kind == "ears") { return ["human", "elf", "cat", "wolf", "bear", "rabbit", "demon"]; }
    if (kind == "beard") { return ["stubble", "short", "full", "long", "braided", "goatee", "mustache"]; }
    if (kind == "tail") { return ["cat", "wolf", "bear", "rabbit", "demon"]; }
    return [];
}
