// The character rig: ten body-part item displays (head, torso, upper arms,
// forearms, thighs, shins) plus two held items, riding an invisible body
// entity (see PLAN.md, "Character rig"). tools/viewer/rig.js mirrors the
// math in rigRender: keep the two in step.
//
// A rig is keyed by a rig id (the player's UUID, or "npc<n>"). Each part's
// item carries the appearance in its custom model data: strings pick the
// layers (build, armor, hair/tail, ears, beard) and colors tint them.
//
// Frames: the character frame has +X left, +Y up, +Z forward. Model pixels
// are 1/16 block at scale 1; a part's pivot is its model origin.

/** Per rig: display UUIDs [head, torso, uarmR, uarmL, farmR, farmL,
 * thighR, thighL, shinR, shinL, main, off]. */
declare global rigParts: dict[list];
/** Per rig: appearance dict (see appDefault). */
declare global rigApp: dict[dict];
/** Per rig: the body entity the displays ride. */
declare global rigBody: dict[str];
/** Height of a rider's origin above the body's feet (blocks). */
declare global rigRideY: num;
/** Per rig: left-hand IK offset along a two-handed weapon (px), 0 none. */
declare global rigIk: dict[num];
/** Interpolation ticks used for each pose update, per rig. */
declare global rigInterp: dict[num];

/** A plain appearance (a human man in brown clothes). */
function appDefault(): dict {
    return {
        race: "human", build: "m", scale: 1,
        skin: 0xE0AC85, hair: 0x5A3A22, eye: 0x3C6E9E, cloth: 0x8A6A45, pants: 0x4E4234, horn: 0x2B2420,
        hairStyle: "short", ears: "human", beard: "", tail: "",
        armor: {head: ["", 0, 0], torso: ["", 0, 0], arm: ["", 0, 0], leg: ["", 0, 0]},
        main: "", off: ""
    };
}

/** Helmets that cover the hair. */
function helmHidesHair(kind: str): num {
    if (kind == "chain" || kind == "scale" || kind == "plate" || kind == "bone" || kind == "ranger") {
        return 1;
    }
    return 0;
}

/** Item model of each body display, in rigParts order. */
function rigPartNames(): list[str] {
    return ["head", "torso", "uarm", "uarm", "farm", "farm", "thigh", "thigh", "shin", "shin"];
}

/** Armor slot that dresses body part `part`. */
function rigPartSlot(part: str): str {
    if (part == "uarm" || part == "farm") {
        return "arm";
    }
    if (part == "thigh" || part == "shin") {
        return "leg";
    }
    return part;
}

/** The item for body part `part` (see rigPartNames) of appearance app. */
function rigPartItem(app: dict, part: str): item {
    line armor = (app["armor"] as dict)[rigPartSlot(part)] as list;
    line kind = line armor[1] as str;
    line main = line armor[2] as num;
    line trim = line armor[3] as num;
    line b = app["build"] as str;
    line strs: list[str] = [line b, line kind];
    if (part == "head") {
        line hs = app["hairStyle"] as str;
        line ears = app["ears"] as str;
        if (helmHidesHair(line kind) == 1) {
            line hs = "";
            if (line ears == "human" || line ears == "elf") {
                line ears = "";
            }
        }
        line strs.append(line hs, line ears, app["beard"] as str);
    } else if (part == "torso") {
        line strs.append(app["tail"] as str);
    }
    line colors: list[num] = [app["skin"] as num, app["hair"] as num, app["eye"] as num, app["cloth"] as num, line main, line trim, app["horn"] as num, app["pants"] as num];
    return item("paper").setModel("rpg:body/%var(part)").setModelDataStrings(line strs).setModelDataNumbers(line colors, type="Colors");
}

/** The item model of held item spec `spec` ("" for nothing). Specs are
 * "<model>|<c1>|<c2>|<c3>" from itemHeldSpec. */
function rigHeldItem(spec: str): item {
    if (spec == "") {
        return item("paper").setModel("rpg:empty");
    }
    line p = spec.split("|");
    line it = item("paper").setModel(line p[1] as str);
    if (line p.len() >= 4) {
        line it = line it.setModelDataNumbers([num.parse(line p[2] as str), num.parse(line p[3] as str), num.parse(line p[4] as str)], type="Colors");
    }
    if (line p.len() >= 5) {
        line it = line it.setModelDataStrings([line p[5] as str]);
    }
    return line it;
}

/** Left-hand IK offset (px along the weapon from the right fist) for held
 * item spec `spec`, 0 when the weapon is held in one hand. Mirrors
 * ikOffset() in tools/viewer/viewer.js. */
function rigIkOffset(spec: str): num {
    if (spec == "") {
        return 0;
    }
    line t = ((spec.split("|"))[1] as str).replace("rpg:weapon/", "");
    if (line t == "greatsword" || line t == "greataxe" || line t == "warhammer" || line t == "scythe") {
        return -3.6;
    }
    if (line t == "spear" || line t == "halberd") {
        return 7;
    }
    return 0;
}

/** Spawns the rig `rid` riding body entity `body`. */
function rigSpawn(rid: str, body: str, at: loc, app: dict) {
    rigRemove(rid);
    if (global rigRideY == 0) {
        global rigRideY = 1.95;
    }
    if (!global rigBuild.hasKeys("m")) {
        loadRigData();
    }
    if (!global animMeta.hasKeys("idle")) {
        loadAnimData();
    }
    line ids: list[str] = [];
    for (line p of rigPartNames()) {
        game.spawnItemDisplay(at, rigPartItem(app, line p as str));
        line ids.append(lastEntity.uuid);
    }
    game.spawnItemDisplay(at, rigHeldItem(app["main"] as str));
    line ids.append(lastEntity.uuid);
    game.spawnItemDisplay(at, rigHeldItem(app["off"] as str));
    line ids.append(lastEntity.uuid);
    // A display that failed to spawn (unloaded chunk) leaves no UUID: give
    // up on the whole rig so nothing draws with a missing part.
    line ok = 1;
    for (line id of line ids) {
        if ("%var(id)".len() < 30) {
            line ok = 0;
        }
    }
    if (line ok == 0) {
        select entitiesByName(line ids);
        selectedEntity.remove();
        select reset;
        return;
    }
    select entitiesByName(line ids);
    selectedEntity.ride(body);
    selectedEntity.setDisplayCullingSize(3, 3);
    select reset;
    global rigParts[rid] = line ids;
    global rigApp[rid] = app;
    global rigIk[rid] = rigIkOffset(app["main"] as str);
    global rigBody[rid] = body;
    global rigInterp[rid] = 2;
}

/** Removes rig `rid`'s displays. */
function rigRemove(rid: str) {
    if (!global rigParts.hasKeys(rid)) {
        return;
    }
    select entitiesByName(global rigParts[rid] as list[str]);
    selectedEntity.remove();
    select reset;
    global rigParts.remove(rid);
    global rigApp.remove(rid);
    global rigBody.remove(rid);
}

/** Re-sends every part item (after an appearance or equipment change). */
function rigRefresh(rid: str, app: dict) {
    if (!global rigParts.hasKeys(rid)) {
        return;
    }
    global rigApp[rid] = app;
    global rigIk[rid] = rigIkOffset(app["main"] as str);
    line ids = global rigParts[rid] as list[str];
    line parts = rigPartNames();
    repeat (line i to 10) {
        select entitiesByName(line ids[line i]);
        selectedEntity.setItemDisplayItem(rigPartItem(app, line parts[line i] as str));
        select reset;
    }
    select entitiesByName(line ids[11]);
    selectedEntity.setItemDisplayItem(rigHeldItem(app["main"] as str));
    select reset;
    select entitiesByName(line ids[12]);
    selectedEntity.setItemDisplayItem(rigHeldItem(app["off"] as str));
    select reset;
}

/** Rotates basis vectors a, b, c (left, up, forward) by pitch (about a,
 * positive swings -b toward +c), yaw (about b, positive turns c toward
 * +a) and roll (about c, positive moves -b toward +a), in that order.
 * Returns the new [a, b, c]. */
function basisRot(a: vec, b: vec, c: vec, p: num, y: num, r: num): list[vec] {
    line na = a;
    line nb = b;
    line nc = c;
    if (y != 0) {
        line nc = line nc.rotateAroundVec(line nb, y);
        line na = line na.rotateAroundVec(line nb, y);
    }
    if (p != 0) {
        line nb = line nb.rotateAroundVec(line na, 0 - p);
        line nc = line nc.rotateAroundVec(line na, 0 - p);
    }
    if (r != 0) {
        line nb = line nb.rotateAroundVec(line nc, r);
        line na = line na.rotateAroundVec(line nc, r);
    }
    return [line na, line nb, line nc];
}

/** Row-major display matrix for a part with basis (a, b, c), scale s and
 * translation t (blocks, relative to the display's origin). Undoes the
 * display's 180 degree turn (model +X left, +Z forward). */
function rigMatrix(a: vec, b: vec, c: vec, s: num, t: vec): list[num] {
    return [0 - a.x * s, b.x * s, 0 - c.x * s, t.x, 0 - a.y * s, b.y * s, 0 - c.y * s, t.y, 0 - a.z * s, b.z * s, 0 - c.z * s, t.z, 0, 0, 0, 1];
}

/** Sets display `id` to matrix m with the rig's interpolation. */
function rigSetMatrix(id: str, m: list[num], interp: num) {
    select entitiesByName(id);
    selectedEntity.setDisplayTransformationMatrix(m);
    selectedEntity.setDisplayInterpolation(interp, 0);
    select reset;
}

/** Poses rig `rid`: yaw (Minecraft degrees) turns the whole character, pose
 * is a list of animation channels (see chan() and pack/src/anim_clips.py).
 * Returns the world offset of the right hand from the feet (blocks). */
function rigRender(rid: str, yaw: num, pose: list[num]): vec {
    line ids = global rigParts[rid] as list[str];
    if (line ids.len() != 12) {
        global rigParts.remove(rid);
        return vec(0, 0, 0);
    }
    line app = global rigApp[rid];
    line rb = global rigBuild[line app["build"] as str] as list[num];
    line hipY = line rb[1];
    line hipX = line rb[2];
    line s = (line app["scale"] as num) * 0.9;
    line px = line s / 16;
    line interp = global rigInterp[rid];

    // Root frame from the yaw. Bob and fwd are keyed for hips 12 px up.
    line L = vec(num.cos(yaw), 0, num.sin(yaw));
    line U = vec(0, 1, 0);
    line F = vec(0 - num.sin(yaw), 0, num.cos(yaw));
    line kb = line hipY / 12 * line px;
    line hip = vec(0, 0 - global rigRideY, 0) + U * (pose[3] * line kb + line hipY * line px) + F * (pose[4] * line kb);
    // Whole body about the hips: pitch tips forward, roll to its left.
    if (pose[1] != 0) {
        line U = U.rotateAroundVec(L, pose[1]);
        line F = F.rotateAroundVec(L, pose[1]);
    }
    if (pose[2] != 0) {
        line U = U.rotateAroundVec(F, 0 - pose[2]);
        line L = L.rotateAroundVec(F, 0 - pose[2]);
    }

    // Torso, and the head at the neck.
    line tb = basisRot(L, U, F, 0 - pose[5], pose[6], 0 - pose[7]);
    line ta = line tb[1];
    line tu = line tb[2];
    line tf = line tb[3];
    rigSetMatrix(line ids[2], rigMatrix(line ta, line tu, line tf, line s, line hip), line interp);
    line neck = line hip + line tu * ((line rb[3] - line hipY) * line px);
    line hb = basisRot(line ta, line tu, line tf, 0 - pose[8], pose[9], 0);
    rigSetMatrix(line ids[1], rigMatrix(line hb[1], line hb[2], line hb[3], line s, line neck), line interp);

    // Arms: upper arm from the shoulder, forearm from the elbow; "out"
    // moves the arm away from the body.
    line shoulder = line hip + line tu * ((line rb[5] - line hipY) * line px);
    line uaLen = line rb[6] * line px;
    line faLen = line rb[7] * line px;
    line shR = line shoulder - line ta * (line rb[4] * line px);
    line ur = basisRot(line ta, line tu, line tf, pose[10], pose[11], 0 - pose[12]);
    rigSetMatrix(line ids[3], rigMatrix(line ur[1], line ur[2], line ur[3], line s, line shR), line interp);
    line elR = line shR - (line ur[2] as vec) * line uaLen;
    line fr = basisRot(line ur[1], line ur[2], line ur[3], pose[13], 0, 0);
    rigSetMatrix(line ids[5], rigMatrix(line fr[1], line fr[2], line fr[3], line s, line elR), line interp);
    line shL = line shoulder + line ta * (line rb[4] * line px);
    line ul = basisRot(line ta, line tu, line tf, pose[14], pose[15], pose[16]);
    line elL = line shL - (line ul[2] as vec) * line uaLen;
    line fl = basisRot(line ul[1], line ul[2], line ul[3], pose[17], 0, 0);
    line gripL = line elL - (line fl[2] as vec) * line faLen;
    line ik = global rigIk[rid];
    if (line ik != 0) {
        // Two-handed: the left hand takes the handle ik px along the weapon
        // from the right fist (two-bone IK, the elbow out and down).
        line wr = basisRot(line fr[1], line fr[3], (line fr[2] as vec) * -1, pose[24], pose[25], pose[26]);
        line gripL = line elR - (line fr[2] as vec) * line faLen + (line wr[2] as vec) * (line ik * line px);
        line toT = line gripL - line shL;
        line dist = num.clamp(line toT.len(), num.abs(line uaLen - line faLen) + 0.001, line uaLen + line faLen - 0.001);
        line n = line toT.setLength(1) as vec;
        line cosA = num.clamp((line uaLen * line uaLen + line dist * line dist - line faLen * line faLen) / (2 * line uaLen * line dist), -1, 1);
        line pole = line ta * 0.7 - line tu - line tf * 0.4;
        line pp = (line pole - line n * (line pole.dot(line n) as num)).setLength(1) as vec;
        line u = (line n * line cosA + line pp * (1 - line cosA * line cosA) ** 0.5) as vec;
        line elL = line shL + line u * line uaLen;
        line w = (line shL + line n * line dist - line elL).setLength(1) as vec;
        line uc = (line w - line u * (line w.dot(line u) as num)) as vec;
        if (line uc.len() < 0.001) {
            line uc = (line tf - line u * (line tf.dot(line u) as num)) as vec;
        }
        line ub = (line u * -1) as vec;
        line ucn = line uc.setLength(1) as vec;
        line ua = line ub.cross(line ucn) as vec;
        line ul = [line ua, line ub, line ucn];
        line fb = (line w * -1) as vec;
        line fc = line ua.cross(line fb) as vec;
        line fl = [line ua, line fb, line fc];
    }
    rigSetMatrix(line ids[4], rigMatrix(line ul[1], line ul[2], line ul[3], line s, line shL), line interp);
    rigSetMatrix(line ids[6], rigMatrix(line fl[1], line fl[2], line fl[3], line s, line elL), line interp);

    // Legs from the hips (root frame, not the torso's); knees bend back.
    line thLen = line rb[8] * line px;
    line hR = line hip - L * (line hipX * line px);
    line tr = basisRot(L, U, F, pose[18], 0, 0 - pose[19]);
    rigSetMatrix(line ids[7], rigMatrix(line tr[1], line tr[2], line tr[3], line s, line hR), line interp);
    line sr = basisRot(line tr[1], line tr[2], line tr[3], 0 - pose[20], 0, 0);
    rigSetMatrix(line ids[9], rigMatrix(line sr[1], line sr[2], line sr[3], line s, line hR - (line tr[2] as vec) * line thLen), line interp);
    line hL = line hip + L * (line hipX * line px);
    line tl = basisRot(L, U, F, pose[21], 0, pose[22]);
    rigSetMatrix(line ids[8], rigMatrix(line tl[1], line tl[2], line tl[3], line s, line hL), line interp);
    line sl = basisRot(line tl[1], line tl[2], line tl[3], 0 - pose[23], 0, 0);
    rigSetMatrix(line ids[10], rigMatrix(line sl[1], line sl[2], line sl[3], line s, line hL - (line tl[2] as vec) * line thLen), line interp);

    // Held items in the fists: the item's +Y points out of the fist along
    // the forearm's forward, its +Z down the forearm.
    line gripR = line elR - (line fr[2] as vec) * line faLen;
    line wb = basisRot(line fr[1], line fr[3], (line fr[2] as vec) * -1, pose[24], pose[25], pose[26]);
    rigSetMatrix(line ids[11], rigMatrix(line wb[1], line wb[2], line wb[3], line s, line gripR), line interp);
    line ob = basisRot(line fl[1], line fl[3], (line fl[2] as vec) * -1, pose[27], pose[28], pose[29]);
    line os = line s;
    if (line ik != 0) {
        // The left hand is on the two-handed weapon: nothing else in it.
        line os = 0;
    }
    rigSetMatrix(line ids[12], rigMatrix(line ob[1], line ob[2], line ob[3], line os, line gripL), line interp);
    return line gripR + vec(0, global rigRideY, 0);
}
